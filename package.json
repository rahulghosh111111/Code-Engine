{
  "name": "code-engine",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "engine",
    "worker",
    "packages/*",
    "runners/*",
    "scripts"
  ],
  "prisma": {
    "schema": "./database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "echo \"No build required\"",
    "start": "pnpm -r start",
    "build-runners": "pnpm -r build",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema ./database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./database/prisma/schema.prisma --name init",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",

    "prisma": "^7.10.0"
  }
}
